        <mxCell id="HYCyX_AIick6Ktpu3Yt5-101" value="CREATE TABLE `manual_match_log` (&lt;br&gt;&amp;nbsp; `id` int NOT NULL AUTO_INCREMENT COMMENT &#39;主鍵ID&#39;,&lt;br&gt;&amp;nbsp; `standard_id` int NOT NULL COMMENT &#39;比賽id&#39;,&lt;br&gt;&amp;nbsp; `sport_id` smallint DEFAULT 1 COMMENT &#39;体育类型&#39;,&lt;br&gt;&amp;nbsp; `type` tinyint NOT NULL DEFAULT 1 COMMENT &#39;日志類型:1=比賽,2=比分，3=狀態，4=盤口&#39;,&lt;br&gt;&amp;nbsp; `operate` tinyint NOT NULL COMMENT &#39;操作類型:1=新增,2=修改，3=刪除&#39;,&lt;br&gt;&amp;nbsp; `back_info` varchar(500) COMMENT &#39;變更前的副本信息&#39;,&lt;br&gt;&amp;nbsp; `new_info` varchar(500) NOT NULL COMMENT &#39;變更后的信息&#39;,&lt;br&gt;&amp;nbsp; `create_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT &#39;創建時間&#39;,&lt;br&gt;&amp;nbsp; `update_by` varchar(50) NOT NULL COMMENT &#39;操作人&#39;,&lt;br&gt;&amp;nbsp; `update_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT &#39;修改時間&#39;,&lt;br&gt;&amp;nbsp; PRIMARY KEY (`id`) USING BTREE,&lt;br&gt;&amp;nbsp; KEY `idx_standard_type_time` (`standard_id`, `type`, `create_time`)&lt;br&gt;) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC COMMENT=&#39;手動賽事日志表&#39;;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=13;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
